# Copiar estos valores al entorno local; no subir secretos al repositorio.
DB_URL=jdbc:postgresql://localhost:5432/tracking_logistico
DB_USERNAME=tracking
DB_PASSWORD=replace-with-local-password
OPERATOR_USERNAME=operador
OPERATOR_PASSWORD=replace-with-long-random-password
ADMIN_USERNAME=administrador
ADMIN_PASSWORD=replace-with-another-long-password
VIEWER_USERNAME=consulta
VIEWER_PASSWORD=replace-with-a-third-long-password
FRONTEND_ORIGIN=http://localhost:3000
# Opcional: IA de atención. La clave solo se usa en el backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

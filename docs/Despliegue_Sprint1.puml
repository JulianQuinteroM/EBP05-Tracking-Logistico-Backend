@startuml
title Despliegue propuesto - Sprint 1 (equipo básico)
actor "Visitante / cliente" as visitor
actor "Operador" as operator
node "Navegador" as browser {
  artifact "Front Next.js / React" as front
}
node "Render (propuesta; no desplegado)" as render {
  artifact "Spring Boot 3.5 API\nJava 21 bytecode" as api
}
database "PostgreSQL\nFlyway V1" as db
visitor --> front : seguimiento público
operator --> front : operaciones internas
front --> api : HTTPS / JSON\nproxy de sesión pendiente
api --> db : JDBC / JPA
note right of api
  Variables de entorno:
  DB_URL, DB_USERNAME, DB_PASSWORD,
  OPERATOR_USERNAME, OPERATOR_PASSWORD,
  FRONTEND_ORIGIN
end note
note bottom of front
  No exponer credenciales de operador
  en JavaScript del navegador.
end note
@enduml
